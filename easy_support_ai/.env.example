# Chave da API OpenAI (obrigatória)
OPENAI_API_KEY=sua_chave_aqui

# Modelo para geração fundamentada e estruturada (OpenAI)
OPENAI_MODEL=gpt-4o-mini

# Modelo para embeddings dos documentos no ChromaDB
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Hiperparâmetros RAG
RAG_TOP_K=5
RAG_MIN_SCORE=0.45
MAX_CONTEXT_TOKENS=3500

# Limiar de confiança do classificador para sugerir ação
CLASSIFIER_CONFIDENCE_MIN=0.65
